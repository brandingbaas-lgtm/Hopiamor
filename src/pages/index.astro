---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import EventCard from '../components/EventCard.astro';
import SectionHead from '../components/SectionHead.astro';
import WordOfTheDay from '../components/WordOfTheDay.astro';
import Form from '../components/Form.astro';
import { getCollection } from 'astro:content';
import events from '../data/events.json';
import food from '../data/food.json';
import music from '../data/music.json';
import { site } from '../lib/site';

const posts = (await getCollection('magazine')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured.id).slice(0, 5);
const upcoming = events.filter((e) => e.featured).concat(events.filter((e) => !e.featured)).slice(0, 4);
const spots = food.slice(0, 3);
const artists = music.filter((m) => m.hopiAmor).slice(0, 4);
const issue = new Date().toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' });
---
<Base title={site.name}>
  <section class="masthead">
    <div class="wrap">
      <div class="issue-line">
        <span>Editie {issue}</span>
        <span>Afro-Caribisch Nederland</span>
        <span>Vanuit Amersfoort</span>
      </div>
      <p class="nameplate" aria-hidden="true"><span>Hopi</span><span class="amor">Amor</span></p>
      <h1 class="sr-only">Hopi Amor, magazine en gids voor Afro-Caribisch Nederland</h1>
      <div class="standfirst">
        <p class="lede">Waar eet je stoba buiten Willemstad? Wie speelt er dit najaar? Waar staat de dominotafel? Het magazine en de gids van Afro-Caribisch Nederland, gemaakt door de mensen achter het Caribbean Family Festival in FLUOR.</p>
        <div class="btn-row"><a class="btn coral" href="/agenda/">Agenda</a><a class="btn ghost" href="/aanmelden/">Iets aanmelden</a></div>
      </div>

      <div class="cover-grid">
        <a class="cover-story" href={`/magazine/${featured.id}/`}>
          <div class="cover"><Art color={featured.data.color} motif={featured.data.motif} label={featured.data.coverWord} kicker="Coververhaal" image={featured.data.image} /></div>
          <span class={`tag ${featured.data.tagColor ?? ''}`}>{featured.data.category}</span>
          <h2>{featured.data.title}</h2>
          <p class="lede">{featured.data.description}</p>
        </a>
        <aside class="issue-index">
          <h3>In dit nummer</h3>
          <ol>
            {rest.map((p) => (
              <li><div><a href={`/magazine/${p.id}/`}>{p.data.title}</a><span>{p.data.category} · {p.data.readingTime} min</span></div></li>
            ))}
          </ol>
          <a class="more" href="/magazine/">Alle verhalen</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <nav class="rubrieken" aria-label="Rubrieken">
        <a class="rubriek" href="/agenda/"><b>01</b><strong>Agenda</strong><span>Festivals, feesten, Keti Koti en dominoavonden</span></a>
        <a class="rubriek" href="/eten/"><b>02</b><strong>Eten</strong><span>Sancocho, stoba, roti en pom, per stad</span></a>
        <a class="rubriek" href="/muziek/"><b>03</b><strong>Muziek</strong><span>Bands, DJ's, zangers en rappers</span></a>
        <a class="rubriek" href="/makers/"><b>04</b><strong>Makers</strong><span>Vertellers, dansers, dichters</span></a>
        <a class="rubriek" href="/community/"><b>05</b><strong>Community</strong><span>Organisaties en netwerken</span></a>
      </nav>
    </div>
  </section>

  <section class="section sand">
    <div class="wrap">
      <SectionHead eyebrow="Agenda" title="Binnenkort in Nederland" more={{ href: '/agenda/', label: 'Volledige agenda' }} />
      <div class="grid cols-2">
        {upcoming.map((e) => <EventCard event={e} />)}
      </div>
      <p class="small mt-2">Data onder voorbehoud bevestigen we zodra de organisator ze publiceert. Mis je iets? <a href="/aanmelden/">Meld een evenement aan</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow palm">Eten &amp; drinken</span>
        <h2>De liefde gaat door de <em>mond</em></h2>
        <p class="lede">Van roti-adressen in Amsterdam-Oost tot de families die op ons festival sancocho koken. De eetgids groeit adres voor adres, en elk adres proeven we zelf.</p>
        <div class="list mt-2">
          {spots.map((s) => (
            <div class="row">
              <div class="cover"><Art color={s.color as any} motif="plate" label={s.name} /></div>
              <div>
                <h3>{s.name}</h3>
                <p>{s.summary}</p>
                <div class="meta"><span>{s.kitchen}</span><span>{s.city}{s.area ? `, ${s.area}` : ''}</span></div>
              </div>
            </div>
          ))}
        </div>
        <div class="btn-row mt-2"><a class="btn" href="/eten/">Naar de eetgids</a><a class="btn ghost" href="/aanmelden/#eettent">Adres aanmelden</a></div>
      </div>
      <div class="art-block"><Art color="palm" motif="plate" kicker="Rubriek 02" /></div>
    </div>
  </section>

  <section class="section ink">
    <div class="wrap">
      <SectionHead eyebrow="Muziek" title="Stond op Hopi Amor 2026" more={{ href: '/muziek/', label: 'Alle artiesten' }} />
      <div class="grid cols-4">
        {artists.map((a) => (
          <article class="card">
            <div class="cover square"><Art color={a.color as any} motif={a.motif as any} label={a.name} kicker={a.kind} /></div>
            <div class="body">
              <div class="meta">{a.genres.join(' · ')}</div>
              <h3>{a.name}</h3>
              <p>{a.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="art-block"><Art color="coral" label="24 mei 2026" kicker="Terugblik" /></div>
      <div>
        <span class="eyebrow">Het festival</span>
        <h2>Hopi Amor Caribbean Family Festival</h2>
        <p class="lede">Op zondag 24 mei 2026 stroomde FLUOR vol: dampende ritmes, dominomatches en drie generaties op één dansvloer. In 2027 komen we terug, groter.</p>
        <div class="stats mt-2">
          <div class="stat"><strong>4,8</strong><span>gemiddelde score van bezoekers</span></div>
          <div class="stat"><strong>284</strong><span>VIP-aanmeldingen voor 2027</span></div>
          <div class="stat"><strong>3</strong><span>generaties in één zaal</span></div>
          <div class="stat"><strong>8</strong><span>koppels aan de dominotafel</span></div>
        </div>
        <div class="btn-row mt-2"><a class="btn coral" href="/festival/#vip">VIP-lijst 2027</a><a class="btn ghost" href="/festival/">Terugblik</a></div>
      </div>
    </div>
  </section>

  <section class="section sun">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Gemeentes, fondsen, podia en ondernemers</span>
        <h2>Samenwerken met de community? Hier begint het.</h2>
        <p class="lede">Wij verbinden jouw programma, budget of locatie aan artiesten, cateraars, vertellers en families die al klaarstaan. In Amersfoort bewezen, landelijk inzetbaar.</p>
        <div class="btn-row mt-1"><a class="btn" href="/samenwerken/">Wat we bieden</a><a class="btn ghost" href="/samenwerken/#gesprek">Plan een gesprek</a></div>
      </div>
      <div class="props">
        <div class="prop"><div class="n">1</div><div><h3>Bereik</h3><p>Een community die je via de gewone kanalen niet bereikt, wel via ons.</p></div></div>
        <div class="prop"><div class="n">2</div><div><h3>Programmering</h3><p>Artiesten, makers en cateraars die we kennen, van dominotafel tot festival.</p></div></div>
        <div class="prop"><div class="n">3</div><div><h3>Verhalen</h3><p>Jouw samenwerking krijgt een plek in het magazine en de agenda.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section" id="nieuwsbrief">
    <div class="wrap split">
      <div>
        <span class="eyebrow sea">Nieuwsbrief</span>
        <h2>Om de twee weken in je inbox</h2>
        <p class="lede">Nieuwe adressen, evenementen en verhalen, en als eerste de line-up van Hopi Amor 2027.</p>
        <div class="mt-2"><WordOfTheDay /></div>
      </div>
      <div class="form-card">
        <Form name="nieuwsbrief" subject="Aanmelding nieuwsbrief Hopi Amor" submitLabel="Aanmelden">
          <div class="two">
            <label>Voornaam <input type="text" name="voornaam" required placeholder="bijv. Soraya" /></label>
            <label>E-mailadres <input type="email" name="email" required placeholder="jij@voorbeeld.nl" /></label>
          </div>
          <label>Woonplaats (optioneel) <input type="text" name="woonplaats" placeholder="bijv. Amersfoort" /></label>
        </Form>
      </div>
    </div>
  </section>
</Base>
