---
import { formatDate } from '../lib/site';
import { getPhoto } from '../lib/photos';
import Photo from './Photo.astro';
interface Props { event: any; }
const { event } = Astro.props;
const date = formatDate(event.date);
const photo = getPhoto(event.photo);
const isExternal = event.url?.startsWith('http');
---
<article class:list={['event', { featured: event.featured, 'has-photo': !!photo }]}>
  <div class:list={['date', { tba: !date }]}>
    {date ? (<><b>{date.day}</b><span>{date.month}</span></>) : (<b>Datum volgt</b>)}
  </div>
  <div>
    <div class="meta">
      <span class="tag">{event.type}</span>
      {event.featured && <span class="tag coral">Uitgelicht</span>}
      {event.status === 'te-bevestigen' && <span class="tag outline">Onder voorbehoud</span>}
    </div>
    <h3>{event.title}</h3>
    <p>{event.summary}</p>
    <dl class="facts">
      <div><dt>Waar</dt><dd>{event.venue ? `${event.venue}, ` : ''}{event.city}</dd></div>
      {date && <div><dt>Wanneer</dt><dd>{date.full}</dd></div>}
      {event.time && <div><dt>Tijd</dt><dd>{event.time}</dd></div>}
      {event.price && <div><dt>Toegang</dt><dd>{event.price}</dd></div>}
      {event.organizer && <div><dt>Door</dt><dd>{event.organizer}</dd></div>}
    </dl>
    {event.url && <a class="more" href={event.url} rel={isExternal ? 'noopener' : undefined} target={isExternal ? '_blank' : undefined}>Meer info</a>}
  </div>
  {photo && <div class="event-photo"><Photo photo={photo} sizes="(max-width: 700px) 100vw, 150px" /></div>}
</article>
