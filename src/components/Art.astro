---
/**
 * Decorative cover art. No stock photos yet, so every item gets a
 * colour block with a motif. Swap for real photos by passing `image`.
 */
interface Props {
  color?: 'sun' | 'coral' | 'sea' | 'palm' | 'plum' | 'ink' | 'sand';
  motif?: 'sun' | 'waves' | 'domino' | 'palm' | 'drum' | 'plate' | 'mic' | 'people' | 'star' | 'book' | 'flag';
  image?: string;
  alt?: string;
  initials?: string;
}
const { color = 'sun', motif = 'sun', image, alt = '', initials } = Astro.props;
const stroke = color === 'sun' || color === 'sand' ? '#16120f' : '#fbf5ec';
---
{image ? (
  <img src={image} alt={alt} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
) : (
  <div class={`art ${color}`} aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" stroke={stroke} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.9">
      {motif === 'sun' && (
        <g>
          <circle cx="100" cy="100" r="34" fill={stroke} stroke="none" />
          {Array.from({ length: 12 }).map((_, i) => {
            const a = (i * Math.PI) / 6;
            const x1 = 100 + Math.cos(a) * 50, y1 = 100 + Math.sin(a) * 50;
            const x2 = 100 + Math.cos(a) * 78, y2 = 100 + Math.sin(a) * 78;
            return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
          })}
        </g>
      )}
      {motif === 'waves' && (
        <g>
          {[50, 80, 110, 140].map((y) => (
            <path d={`M10 ${y} C 35 ${y - 18}, 55 ${y + 18}, 80 ${y} S 125 ${y - 18}, 150 ${y} S 185 ${y + 18}, 190 ${y}`} />
          ))}
        </g>
      )}
      {motif === 'domino' && (
        <g>
          <rect x="45" y="30" width="110" height="140" rx="12" fill={stroke} stroke="none" />
          <line x1="55" y1="100" x2="145" y2="100" stroke={color === 'sun' || color === 'sand' ? '#fbf5ec' : '#16120f'} stroke-width="4" />
          {[[70, 55], [100, 65], [130, 55], [70, 80], [130, 80], [70, 120], [100, 135], [130, 120], [70, 150], [130, 150]].map(([cx, cy]) => (
            <circle cx={cx} cy={cy} r="7" fill={color === 'sun' || color === 'sand' ? '#fbf5ec' : '#16120f'} stroke="none" />
          ))}
        </g>
      )}
      {motif === 'palm' && (
        <g>
          <path d="M100 180 C 98 130, 96 100, 104 70" />
          <path d="M104 70 C 70 60, 45 75, 30 100" />
          <path d="M104 70 C 140 55, 165 70, 175 95" />
          <path d="M104 70 C 90 40, 60 30, 35 45" />
          <path d="M104 70 C 120 35, 150 25, 175 40" />
          <path d="M104 70 C 100 45, 105 25, 115 15" />
          <circle cx="112" cy="82" r="7" fill={stroke} stroke="none" />
          <circle cx="98" cy="86" r="7" fill={stroke} stroke="none" />
        </g>
      )}
      {motif === 'drum' && (
        <g>
          <ellipse cx="100" cy="55" rx="55" ry="16" fill={stroke} stroke="none" />
          <path d="M45 55 L 60 165 L 140 165 L 155 55" />
          <path d="M60 165 C 80 175, 120 175, 140 165" />
          <line x1="70" y1="65" x2="80" y2="140" /><line x1="130" y1="65" x2="120" y2="140" /><line x1="100" y1="70" x2="100" y2="150" />
        </g>
      )}
      {motif === 'plate' && (
        <g>
          <circle cx="100" cy="100" r="70" /><circle cx="100" cy="100" r="48" />
          <path d="M80 92 C 88 78, 112 78, 120 92 C 128 106, 112 122, 100 118 C 84 116, 74 104, 80 92 Z" fill={stroke} stroke="none" />
          <line x1="22" y1="60" x2="22" y2="150" /><line x1="178" y1="60" x2="178" y2="150" /><path d="M14 60 L 14 85 C 14 92, 30 92, 30 85 L 30 60" />
        </g>
      )}
      {motif === 'mic' && (
        <g>
          <rect x="80" y="30" width="40" height="80" rx="20" fill={stroke} stroke="none" />
          <path d="M60 95 C 60 125, 140 125, 140 95" /><line x1="100" y1="125" x2="100" y2="160" /><line x1="75" y1="160" x2="125" y2="160" />
        </g>
      )}
      {motif === 'people' && (
        <g>
          <circle cx="60" cy="70" r="16" fill={stroke} stroke="none" /><circle cx="100" cy="58" r="18" fill={stroke} stroke="none" /><circle cx="140" cy="70" r="16" fill={stroke} stroke="none" />
          <path d="M35 150 C 35 105, 85 105, 85 150" /><path d="M70 150 C 70 95, 130 95, 130 150" /><path d="M115 150 C 115 105, 165 105, 165 150" />
        </g>
      )}
      {motif === 'star' && (
        <g>
          <path d="M100 25 L 118 75 L 172 78 L 130 110 L 145 162 L 100 132 L 55 162 L 70 110 L 28 78 L 82 75 Z" fill={stroke} stroke="none" />
        </g>
      )}
      {motif === 'book' && (
        <g>
          <path d="M100 55 C 80 40, 50 42, 30 50 L 30 150 C 50 142, 80 140, 100 155 Z" fill={stroke} stroke="none" />
          <path d="M100 55 C 120 40, 150 42, 170 50 L 170 150 C 150 142, 120 140, 100 155 Z" />
        </g>
      )}
      {motif === 'flag' && (
        <g>
          <line x1="50" y1="30" x2="50" y2="175" stroke-width="6" />
          <path d="M55 40 C 90 25, 120 55, 160 40 L 160 105 C 120 120, 90 90, 55 105 Z" fill={stroke} stroke="none" />
        </g>
      )}
    </svg>
    {initials && <span class="initials">{initials}</span>}
  </div>
)}
