---
/**
 * Poster-style cover: colour field, halftone dots, one big word.
 * Used until real photos exist; pass `image` to show a photo instead.
 */
interface Props {
  color?: 'sun' | 'coral' | 'sea' | 'palm' | 'plum' | 'ink' | 'sand';
  motif?: 'sun' | 'waves' | 'domino' | 'palm' | 'drum' | 'plate' | 'mic' | 'people' | 'star' | 'book' | 'flag';
  label?: string;
  kicker?: string;
  image?: string;
  alt?: string;
  initials?: string;
}
const { color = 'sun', motif = 'sun', label, kicker, image, alt = '', initials } = Astro.props;

// Papiamentu words as default cover text, one per theme.
const words: Record<string, string> = {
  sun: 'Solo', waves: 'Laman', domino: 'Domino', palm: 'Palma', drum: 'Tambú', plate: 'Kuminda',
  mic: 'Músika', people: 'Famia', star: 'Strea', book: 'Historia', flag: 'Libertat',
};
const text = label ?? initials ?? words[motif];
const lines = text.split(/\s+/);
const longest = Math.max(3, ...lines.map((l) => l.length));
const widthFit = Math.min(40, 158 / longest).toFixed(1);
const heightFit = (74 / (lines.length * 0.95)).toFixed(1);
---
{image ? (
  <img src={image} alt={alt} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
) : (
  <div class={`art ${color}`} aria-hidden="true">
    <span class="disc"></span>
    {kicker && <span class="kicker">{kicker}</span>}
    <div class="art-word" style={`font-size:min(${widthFit}cqw, ${heightFit}cqh)`}>
      {lines.map((l) => <span>{l}</span>)}
    </div>
  </div>
)}
