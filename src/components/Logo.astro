---
/**
 * Wordmark plus a domino tile whose top pip is the sun:
 * the dominotafel is where Hopi Amor started.
 */
interface Props {
  tagline?: boolean;
  theme?: 'light' | 'dark';
  class?: string;
}
const { tagline = true, theme = 'light', class: className = '' } = Astro.props;
const tile = theme === 'dark' ? 'var(--paper)' : 'var(--ink)';
const pip = theme === 'dark' ? 'var(--ink)' : 'var(--paper)';
---
<a class={`brand ${className}`} href="/" aria-label="Hopi Amor, naar de homepage" data-theme={theme}>
  <svg class="mark" viewBox="0 0 24 42" aria-hidden="true">
    <rect x="0" y="0" width="24" height="42" rx="3" fill={tile} />
    <circle cx="12" cy="11" r="6.5" fill="var(--sun)" />
    <rect x="3" y="20.25" width="18" height="1.5" fill={pip} />
    <circle cx="6.5" cy="27" r="2.1" fill="var(--coral)" />
    <circle cx="12" cy="31.5" r="2.1" fill="var(--coral)" />
    <circle cx="17.5" cy="36" r="2.1" fill="var(--coral)" />
  </svg>
  <span class="brand-word"><span>Hopi</span><span class="amor">Amor</span></span>
  {tagline && <small>Afro-Caribisch<br />Nederland</small>}
</a>
