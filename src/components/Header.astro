---
import { nav } from '../lib/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<div class="ticker" aria-hidden="true">
  <span>
    {Array.from({ length: 2 }).map(() => (
      <>
        Nos ta huntu <i>•</i> Magazine <i>•</i> Agenda <i>•</i> Eten <i>•</i> Muziek <i>•</i> Makers <i>•</i> Community <i>•</i> Hopi Amor Festival 2027 <i>•</i> Amersfoort en heel Nederland <i>•</i>
      </>
    ))}
  </span>
</div>
<header class="site-header">
  <div class="wrap">
    <Logo />
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>Menu</button>
    <nav class="nav" id="site-nav" aria-label="Hoofdmenu">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn sun" href="/samenwerken/">Samenwerken</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
