---
import { nav, site } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<div class="ticker" aria-hidden="true">
  <span>
    {Array.from({ length: 2 }).map(() => (
      <>
        Nos ta huntu <i>•</i> Magazine <i>•</i> Agenda <i>•</i> Eten <i>•</i> Muziek <i>•</i> Makers <i>•</i> Community <i>•</i> Hopi Amor Festival 2027 <i>•</i> Amersfoort en heel Nederland <i>•</i>
      </>
    ))}
  </span>
</div>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="#f2b33d" />
        <path d="M20 31 C 12 25, 8 21, 8 15.5 C 8 12 10.7 9.5 14 9.5 C 16.5 9.5 18.6 11 20 13 C 21.4 11 23.5 9.5 26 9.5 C 29.3 9.5 32 12 32 15.5 C 32 21 28 25 20 31 Z" fill="#e4553b" />
      </svg>
      <span>{site.name}<small>Afro-Caribisch Nederland</small></span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>Menu</button>
    <nav class="nav" id="site-nav" aria-label="Hoofdmenu">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn sun" href="/samenwerken/">Samenwerken</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
